# PostgreSQL application database
POSTGRES_DB=optimind
POSTGRES_USER=optimind
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Leave empty for the local macOS user or Ubuntu's postgres system user.
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=

# URL-encode special characters used in the database password.
DATABASE_URL=postgresql+asyncpg://optimind:change_this_password@localhost:5432/optimind

# Local services
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Lightweight vision model used for uploaded-image analysis.
OLLAMA_VISION_MODEL=qwen3.5:0.8b
# Keep the model in memory so the first reply does not repeatedly pay the load cost.
OLLAMA_KEEP_ALIVE=30m
# A smaller context uses less RAM and is faster on older CPUs.
OLLAMA_NUM_CTX=4096
# Two browser windows can generate replies at the same time. Each parallel
# request uses additional RAM, so 2 is the safe default for a 16 GB computer.
OLLAMA_NUM_PARALLEL=2
# Avoid keeping several large models in RAM when model selection changes.
OLLAMA_MAX_LOADED_MODELS=1
# Free local text-to-image generation through stable-diffusion.cpp.
IMAGE_GENERATION_ENABLED=false
IMAGE_GENERATION_BASE_URL=http://localhost:1234
IMAGE_GENERATION_MODEL=lcm-ssd-1b-q4
IMAGE_GENERATION_SIZE=512x512
# CPU is the reliable default on Ubuntu and avoids white Q4 images seen on Metal.
IMAGE_GENERATION_BACKEND=cpu
# LCM is designed for four fast steps and CFG 1.0.
IMAGE_GENERATION_STEPS=4
IMAGE_GENERATION_CFG_SCALE=1.0
IMAGE_GENERATION_SAMPLER=lcm
# Free, self-hosted web search. No API key or account is required.
WEB_SEARCH_ENABLED=true
SEARXNG_BASE_URL=http://localhost:8080
# Website crawl limits. Increase only if you have enough local resources.
OPTIMIND_MAX_SITE_PAGES=100
OPTIMIND_MAX_CRAWL_DEPTH=6
FRONTEND_ORIGIN=http://localhost:5173

# Development server binding. 0.0.0.0 allows access from the private network.
API_HOST=127.0.0.1
API_PORT=8000
VITE_HOST=0.0.0.0
VITE_PORT=5173







