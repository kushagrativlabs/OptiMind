# PostgreSQL application database
POSTGRES_DB=optimind
POSTGRES_USER=optimind
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Leave empty for the local macOS user or Ubuntu's postgres system user.
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=

# URL-encode special characters used in the database password.
DATABASE_URL=postgresql+asyncpg://optimind:change_this_password@localhost:5432/optimind

# Local services
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Free, self-hosted web search. No API key or account is required.
WEB_SEARCH_ENABLED=true
SEARXNG_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173

# Development server binding. 0.0.0.0 allows access from the private network.
API_HOST=127.0.0.1
API_PORT=8000
VITE_HOST=0.0.0.0
VITE_PORT=5173
