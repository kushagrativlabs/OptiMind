POSTGRES_DB=optimind
POSTGRES_USER=optimind
POSTGRES_PASSWORD=optimind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
DATABASE_URL=postgresql+asyncpg://optimind:optimind@localhost:5432/optimind
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
# Larger context is required for complete multi-page website audits.
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_BASE_URL=http://localhost:1234
IMAGE_GENERATION_MODEL=lcm-ssd-1b-q4
IMAGE_GENERATION_SIZE=512x512
IMAGE_GENERATION_BACKEND=cpu
IMAGE_GENERATION_STEPS=4
IMAGE_GENERATION_CFG_SCALE=1.0
IMAGE_GENERATION_SAMPLER=lcm
FRONTEND_ORIGIN=http://localhost:5173
WEB_SEARCH_ENABLED=true
SEARXNG_BASE_URL=http://localhost:8080
